{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ndarray",
  "type": "object",
  "properties": {
    "name": {
      "const": "ndarray"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "dtype": {
          "enum": [
            "bool",
            "int8",
            "int16",
            "int32",
            "int64",
            "uint8",
            "uint16",
            "uint32",
            "uint64",
            "float16",
            "float32",
            "float64",
            "complex64",
            "complex128"
          ]
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": ["dtype", "shape"],
      "additionalProperties": false
    }
  },
  "required": ["name", "configuration"],
  "additionalProperties": false
}
