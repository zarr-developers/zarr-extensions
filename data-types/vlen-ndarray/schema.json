{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vlen-ndarray",
  "type": "object",
  "properties": {
    "name": {
      "const": "vlen-ndarray"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "dtype": {
          "enum": [
            "bool",
            "int8",
            "int16",
            "int32",
            "int64",
            "uint8",
            "uint16",
            "uint32",
            "uint64",
            "float16",
            "float32",
            "float64",
            "complex64",
            "complex128"
          ]
        },
        "inner_shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": ["dtype", "inner_shape"],
      "additionalProperties": false
    }
  },
  "required": ["name", "configuration"],
  "additionalProperties": false
}
